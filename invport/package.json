{
  "name": "invport",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "node -e \"require('node:fs').copyFileSync('staticwebapp.config.json', 'out/staticwebapp.config.json')\"",
    "build:static": "node scripts/build-static.js",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "validate-auth": "node -e \"const { validateAuthConfig } = require('./src/lib/auth/config.ts'); const result = validateAuthConfig(); console.log(result.isValid ? 'OAuth configuration is valid' : 'OAuth configuration errors:', result.errors);\""
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "^2.2.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-charts": "^9.17.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "mssql": "^12.7.13",
    "next": "^16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swr": "^2.5.1",
    "uuid": "^14.0.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.34",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
